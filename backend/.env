PORT=3000
# Meme URL que dans MongoDB Compass
MONGODB_URI=mongodb://127.0.0.1:27017/legaltech
JWT_SECRET=change_me_with_a_long_random_string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:4200

# URL du frontend (utilisee dans les liens envoyes par email)
FRONTEND_URL=http://localhost:4200

# --- Envoi d'emails (OPTIONNEL) ---
# Sans SMTP_HOST : mode dev, les emails sont affiches dans la console du backend
# ET le lien est affiche dans l'application.
# Exemple Gmail (mot de passe d'application requis) :
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=votre.adresse@gmail.com
# SMTP_PASS=mot_de_passe_application
# MAIL_FROM=LegalTech <votre.adresse@gmail.com>
